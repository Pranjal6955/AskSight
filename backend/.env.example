# AskSight backend configuration.
# Copy to `.env` and fill in real values. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string (Neon or local Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret for signing access tokens (HS256). Use at least 32 random bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start without this.
JWT="replace-me-with-a-long-random-string"

# --- Model inference --------------------------------------------------------

# Directory of a trained checkpoint (the unzipped Colab deliverable).
# Leave empty to run the development mock: /ask returns "[mock answer] ...".
# Point it at model/checkpoints/v0.1-colab for real answers.
ASKSIGHT_MODEL_CHECKPOINT=""

# --- Storage ----------------------------------------------------------------

# "local" for development, "s3" for production (any S3-compatible endpoint).
STORAGE_BACKEND="local"

# Directory for stored images, relative to the backend/ folder (local only).
STORAGE_ROOT="storage"

# Required when STORAGE_BACKEND="s3".
STORAGE_S3_BUCKET=""

# Optional key prefix inside the bucket, e.g. "uploads".
STORAGE_S3_PREFIX=""

# The default AWS credential chain is used (env vars, shared config, IAM role).
# AWS_REGION="ap-south-1"

# --- Runtime -----------------------------------------------------------------

# Minimum log level for the structured JSON logs: DEBUG, INFO, WARNING, ERROR.
ASKSIGHT_LOG_LEVEL="INFO"

# --- Speech (Sarvam) --------------------------------------------------------

# Server-side key for speech-to-text and text-to-speech. Never sent to the
# mobile app. Leave empty to keep the mocked provider; the /stt and /tts
# endpoints then return 503 with a clear message.
SARVAM_API_KEY=""

# Sarvam model names. Verified against docs.sarvam.ai in Nov 2026.
SARVAM_STT_MODEL="saaras:v4"
SARVAM_TTS_MODEL="bulbul:v4-flash"

# Default language for speech, as a BCP-47 tag.
DEFAULT_LANGUAGE="en-IN"
